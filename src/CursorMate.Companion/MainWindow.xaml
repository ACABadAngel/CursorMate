<Window x:Class="CursorMate.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorMate • Preview" Width="390" Height="420" MinWidth="340" MinHeight="190"
        Background="#0C1215" Foreground="#F0F5F3"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#1A272B"/>
            <Setter Property="Foreground" Value="#F0F5F3"/>
            <Setter Property="BorderBrush" Value="#33454B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="CursorMate" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Your little AI companion, one click ahead."
                       Foreground="#9DAFB0" Margin="0,4,0,18" FontSize="12"/>
            <Border Background="#132022" CornerRadius="10" Padding="14" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="PRE-ALPHA CURSOR DEMO" Foreground="#75D9CB" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Status" Text="Overlay starting…" Margin="0,7,0,6" FontSize="13"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Visual pointer only. No capture, automation or Codex connection."
                               Foreground="#A7B6B8" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>
            <Button x:Name="DemoTarget" Content="Point at this demo button" Click="DemoTarget_Click"/>
            <Button Content="Park beside real mouse" Click="Park_Click"/>
            <Button x:Name="ToggleCursor" Content="Hide AI cursor" Click="Toggle_Click"/>
            <CheckBox x:Name="ReduceMotion" Content="Reduce cursor motion" Foreground="#F0F5F3"
                      Checked="ReduceMotion_Changed" Unchecked="ReduceMotion_Changed"/>
            <TextBlock Text="Teaching never moves your real Windows cursor."
                       Foreground="#879A9C" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
