<Window x:Class="CursorMate.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorMate" Width="236" Height="48"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="#F0F5F3" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EFF5F2"/>
            <Setter Property="Background" Value="#20282B"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#34433F"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="Background" Value="#34433F"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FA0D1012" BorderBrush="#353E3C" BorderThickness="1" CornerRadius="24" ClipToBounds="True" Padding="7">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Click="Expand_Click" ToolTip="Expand or collapse CursorMate" Background="Transparent" Padding="5,2" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="F0 M3.10042 6.29005C2.40168 4.30935 4.30916 2.40186 6.28987 3.1006L18.8719 7.54103C20.9168 8.263 21.1141 11.0361 19.2801 12.0693L19.0965 12.1641L14.535 14.293C14.4552 14.3302 14.3867 14.3878 14.3367 14.459L14.2928 14.5352L12.1639 19.0967C11.2172 21.1253 8.2861 20.9829 7.54084 18.8721L3.10042 6.29005ZM5.62483 4.98732C5.22864 4.84749 4.8473 5.22882 4.98713 5.62501L9.42756 18.2061C9.57668 18.6281 10.162 18.6566 10.3514 18.251L12.4803 13.6895L12.5819 13.4942C12.8374 13.0525 13.2237 12.6977 13.6893 12.4805L18.2508 10.3516C18.6564 10.1622 18.6279 9.57686 18.2059 9.42775L5.62483 4.98732Z" Fill="#75D9CB" Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/>
                        <TextBlock Text="CursorMate" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#75D9CB" VerticalAlignment="Center" Margin="8,0"/>
                <Button Grid.Column="2" x:Name="ExpandButton" Content="⌄" Click="Expand_Click" ToolTip="Open dock" Padding="9,3"/>
            </Grid>
            <ScrollViewer Grid.Row="1" x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="3,12,3,3">
                <StackPanel>
                    <TextBlock Text="WORKSPACE  /  TEACH" Foreground="#75D9CB" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Status" Text="Idle — visual guidance only" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,10"/>
                    <Border Background="#171C1E" BorderBrush="#2B3434" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Screen context" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Select Inspect, then switch to the desired application within 3 seconds. One local read only; nothing is sent or saved." Foreground="#A7B6B8" TextWrapping="Wrap" Margin="0,5,0,8"/>
                            <Button x:Name="InspectButton" Content="Inspect selected window" Click="Inspect_Click"/>
                            <TextBlock x:Name="ContextText" Text="No window inspected." Foreground="#BFCAC7" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Companion cursor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <Button x:Name="DemoTarget" Content="Point at this button" Click="DemoTarget_Click" Margin="0,0,0,6"/>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="Park cursor" Click="Park_Click" Margin="0,0,3,0"/>
                        <Button Content="Hide / show" Click="Toggle_Click" Margin="3,0,0,0"/>
                    </UniformGrid>
                    <Border Background="#171C1E" BorderBrush="#2B3434" BorderThickness="1" CornerRadius="14" Padding="12">
                        <StackPanel>
                            <TextBlock Text="AI conversation · Offline" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Not connected — subscription authorization and live model responses are the next milestone." Foreground="#A7B6B8" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button Content="Stop / clear" Click="Stop_Click" Margin="0,0,3,0"/>
                        <Button Content="Exit CursorMate" Click="Exit_Click" Margin="3,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
